rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Products Collection
    // ============================================
    // - Read: Anyone (authenticated or not)
    // - Write: Only authenticated admin users
    // ============================================
    match /products/{productId} {

      // Anyone can read products (shopping list is the main use case)
      allow read: if true;

      // Only authenticated admins can create, update, or delete
      allow create, update: if isAdmin() && isValidProduct(productId);
      allow delete: if isAdmin();
    }

    // ============================================
    // Shopping State Collection
    // ============================================
    // - Read/Write: Only the authenticated user who owns the document
    // ============================================
    match /shoppingState/{userId} {
      // Users can only read and write their own shopping state
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['userId', 'updatedAt', 'items'])
        && request.resource.data.keys().hasOnly(['userId', 'updatedAt', 'items'])
        && request.resource.data.userId == userId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 500;
    }

    // ============================================
    // Helper Functions
    // ============================================

    // Check if user is authenticated and is an admin
    // TODO: Replace with actual admin email(s) or use custom claims
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email in getAdminEmails();
    }

    // List of admin emails
    // In production, consider using custom claims instead
    function getAdminEmails() {
      return [
        '90joelmarquez@gmail.com'
      ];
    }

    // Validate product document structure
    function isValidProduct(productId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'name', 'defaultQuantity'])
             && data.keys().hasOnly(['id', 'name', 'defaultQuantity', 'url', 'defaultHay'])
             && data.id is string
             && data.id == productId
             && data.id.size() >= 1
             && data.id.size() <= 100
             && data.name is string
             && data.name.size() >= 1
             && data.name.size() <= 100
             && data.defaultQuantity is int
             && data.defaultQuantity >= 0
             && data.defaultQuantity <= 99
             && (
               !('url' in data.keys())
               || data.url == null
               || (data.url is string && (data.url == '' || (
                 data.url.size() <= 2048
                 && data.url.matches('https://(www[.])?masonline[.]com[.]ar/[^?#]+/p([?].*)?(#.*)?')
               )))
             )
             && (
               !('defaultHay' in data.keys())
               || data.defaultHay is bool
             );
    }
  }
}
